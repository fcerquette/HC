# Copiar a .env.development (local) y completar. En prod, usar variables del hosting.

PORT=3000
NODE_ENV=development

# PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=hc
DB_SYNCHRONIZE=true   # solo dev/pruebas; en prod real -> false + migraciones
DB_LOGGING=false
DB_SSL=false          # en Render/Postgres gestionado -> true

# Firebase
# Dev: emulador (no requiere credenciales reales)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
GCLOUD_PROJECT=demo-hc
# Prod: usar UNA de estas (no commitear el secret)
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# CORS (prod): origenes permitidos separados por coma. Vacio = abierto (solo dev).
# CORS_ORIGIN=https://hc-frontend.onrender.com
