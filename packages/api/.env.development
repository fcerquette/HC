# API
PORT=3000
NODE_ENV=development

# PostgreSQL (Cloud SQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hc
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Firebase Admin
# Ruta al service account JSON, o usar emulador
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
