# Firebase (emulador local — valores demo, no son claves reales)
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-hc
VITE_FIREBASE_STORAGE_BUCKET=demo-hc.appspot.com
